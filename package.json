{
  "name": "flower-details-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"*.{js,cjs,json}\" .postcssrc.json",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\" \"*.{js,cjs,json}\" .postcssrc.json",
    "lint:dependencies": "depcruise --config .dependency-cruiser.cjs src/app",
    "quality": "npm run format:check && npm run lint && npm run lint:dependencies",
    "validate": "npm run quality && npm test -- --watch=false && npm run test:e2e && npm run build ",
    "prepare": "husky"
  },
  "private": true,
  "lint-staged": {
    "*.{ts,html,css,json,md}": "prettier --write",
    "*.{ts,html}": "eslint --fix"
  },
  "packageManager": "npm@11.18.0",
  "dependencies": {
    "@angular/animations": "22.1.2",
    "@angular/cdk": "^22.1.2",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@fortawesome/angular-fontawesome": "^5.1.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "bootstrap": "5.3.8",
    "ng-zorro-antd": "^22.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.5",
    "@angular/cli": "^22.0.5",
    "@angular/compiler-cli": "^22.0.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "angular-eslint": "22.1.0",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.26",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8"
  }
}
