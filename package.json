{
  "name": "flower-details-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"*.{js,cjs,json}\" .postcssrc.json",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\" \"*.{js,cjs,json}\" .postcssrc.json",
    "lint:dependencies": "depcruise --config .dependency-cruiser.cjs src/app",
    "quality": "npm run format:check && npm run lint && npm run lint:dependencies",
    "validate": "npm run quality && npm run build && npm test -- --watch=false",
    "prepare": "husky"
  },
  "private": true,
  "lint-staged": {
    "*.{ts,html,css,json,md}": "prettier --write",
    "*.{ts,html}": "eslint --fix"
  },
  "packageManager": "npm@11.18.0",
  "dependencies": {
    "@angular/cdk": "^22.1.2",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@ng-icons/core": ">=32.0.0 <34.0.0",
    "@ng-icons/lucide": ">=32.0.0 <34.0.0",
    "@spartan-ng/brain": "^1.3.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.5.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.5",
    "@angular/cli": "^22.0.5",
    "@angular/compiler-cli": "^22.0.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@spartan-ng/cli": "^1.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "angular-eslint": "22.1.0",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.26",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8"
  }
}
